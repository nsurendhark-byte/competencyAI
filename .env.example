# Database Connection (SQLite local dev or PostgreSQL / Supabase production)
DATABASE_URL="file:./dev.db"

# Secret Key for Signing User & Admin HTTP-Only Session Tokens
AUTH_SECRET="replace_with_a_secure_random_hash_key_min_32_characters"

# Server-Side Google Gemini AI API Key (For Aura AI Mentor & Competency Gap Analysis)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Application Base URL (Used for authentication redirects & CORS)
APP_URL="http://localhost:3000"

# Optional Provider Integration Keys
EMAIL_PROVIDER_KEY=""
SMS_PROVIDER_KEY=""
